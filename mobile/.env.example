# Flutter does not load .env natively. Prefer dart-define:
# flutter run -d chrome --dart-define=API_BASE_URL=http://127.0.0.1:8765/api/v1
#
# Defaults in AppConfig:
# - Web/Chrome: http://127.0.0.1:8765/api/v1
# - Android emulator: http://10.0.2.2:8765/api/v1
# - Physical device: http://YOUR_LAN_IP:8765/api/v1

API_BASE_URL=http://127.0.0.1:8765/api/v1

APP_NAME="Bynnas Association Integration"
APP_ENV=integration
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8765

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Relative path is OK for artisan CLI; run-mobile-integration.ps1 rewrites this
# to an absolute path before `artisan serve` (serve CWD is under public/).
DB_DATABASE=database/integration.sqlite

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# Allow deliberate fault endpoints for mobile network/server-error tests only.
ENABLE_INTEGRATION_FAULTS=true

# Integration test accounts (override locally; do not commit real secrets)
INTEGRATION_MEMBER_EMAIL=integration.member@bynnas.test
INTEGRATION_MEMBER_PASSWORD=password
INTEGRATION_OTHER_MEMBER_EMAIL=integration.other@bynnas.test
INTEGRATION_OTHER_MEMBER_PASSWORD=password
INTEGRATION_ADMIN_EMAIL=integration.admin@bynnas.test
INTEGRATION_ADMIN_PASSWORD=password

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
